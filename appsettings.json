  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.MSSqlServer",
      "Serilog.Sinks.Oracle"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {}
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../logs/Art-.json",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=192.168.1.45;Database=ART_DB;User Id=sa;Password=P@ssw0rd;MultipleActiveResultSets=true;TrustServerCertificate=True",
          "tableName": "ArtLogs",
          "autoCreateSqlTable": true,
          "columnOptionsSection": {
            "addStandardColumns": [ "LogEvent" ],
            "removeStandardColumns": [ "Properties" ],
            "additionalColumns": [
              {
                "ColumnName": "User",
                "DataType": "NVARCHAR",
                "DataLength": 255,
                "AllowNull": true
              }
            ]
          }
        }
      },
      {
        "Name": "Oracle",
        "Args": {
          "connectionString": "User Id=ART;Password=ART1;Data Source=192.168.1.96:1521/aml71;",
          "tableName": "ArtLogs",
          "autoCreateSqlTable": true,
          "columnOptionsSection": {
            "addStandardColumns": [ "LogEvent" ],
            "removeStandardColumns": [ "Properties" ],
            "additionalColumns": [
              {
                "ColumnName": "User",
                "DataType": "NVARCHAR2",
                "DataLength": 255,
                "AllowNull": true
              }
            ]
          }
        }
      }
    ]
  },
